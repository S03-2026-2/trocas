# Variáveis de ambiente do perfil de produção.
# No Render, cadastre-as em: serviço -> Environment.
# Este arquivo é só um modelo: NUNCA coloque senhas reais aqui (e nunca versione um arquivo .env).

SPRING_PROFILES_ACTIVE=prod

# Dados do serviço MySQL na Aiven (aba Overview). A Aiven exige SSL e usa uma porta própria.
DB_URL=jdbc:mysql://SEU-SERVICO.aivencloud.com:PORTA/trocas?sslMode=REQUIRED
DB_USERNAME=avnadmin
DB_PASSWORD=troque-pela-senha-da-aiven

# Front-ends que podem chamar a API pelo navegador, separados por vírgula (vazio = nenhum)
CORS_ALLOWED_ORIGINS=

# Endereço do broker de eventos (para onde vai o evento de troca realizada).
# Opcional: se não for cadastrada, a API usa http://localhost:8000.
# Não cadastre vazia: valor vazio não cai no padrão.
# BROKER_URL=https://URL-DO-BROKER
